<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widgetAccentDot"
        android:layout_width="4dp"
        android:layout_height="38dp"
        android:layout_marginEnd="8dp"
        android:background="#B57AFF"
        android:contentDescription="@string/app_name" />

    <ImageView
        android:id="@+id/widgetCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_sunify_notif"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:id="@+id/widgetMetaArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sunify"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Müzik Çalınmıyor"
            android:textColor="#B8FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widgetPrevBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="Önceki"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widgetPlayBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Oynat"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widgetNextBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="Sonraki"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFFFFFF" />

</LinearLayout>
